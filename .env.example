# JUMPPER configuration template - NAMES ONLY, never values.
# Real secrets live outside the repository tree.

# Ethereum RPC used for read-only anchor verification (no key required).
JUMPPER_ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Signing is ALWAYS external. JUMPPER never holds a private key.
# Set the path to an external signer socket/binary if you integrate one.
JUMPPER_EXTERNAL_SIGNER=

# Gas ceiling in wei. Anchors above this price are refused, not queued.
JUMPPER_MAX_GAS_PRICE_WEI=30000000000

# Batch policy
JUMPPER_MAX_LEAVES=1000
JUMPPER_MAX_AGE_SECONDS=300
